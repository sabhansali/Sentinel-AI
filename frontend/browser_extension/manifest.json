{
  "manifest_version": 3,
  "name": "Shadow AI Monitor",
  "version": "1.0",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
  "*://chatgpt.com/*",
  "*://*.chatgpt.com/*",
  "*://chat.openai.com/*",
  "*://*.openai.com/*"
],
      "js": ["content_script.js"]
    }
  ],
  "action": { "default_popup": "popup.html" }
}